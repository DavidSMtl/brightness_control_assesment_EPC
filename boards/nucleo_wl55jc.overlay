#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    aliases {
        sw0 = &user_button_2;

        led-red = &led_red_node;
        led-green = &led_green_node;
        led-blue = &led_blue_node;

        analog-in-pin = &ldr_sensor_node;
    };

    rgb_leds {
        compatible = "gpio-leds";

        led_red_node: led_red_node {
            gpios = <&gpiob 3 GPIO_ACTIVE_LOW>;
            label = "LED_RGB_RED";
        };

        led_green_node: led_green_node {
            gpios = <&gpiob 4 GPIO_ACTIVE_LOW>;
            label = "LED_RGB_GREEN";
        };

        led_blue_node: led_blue_node {
            gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
            label = "LED_RGB_BLUE";
        };

    };

    ldr_sensor_node: ldr_sensor_node {
        io-channels = <&adc1 5>; 
    };
};

&adc1 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

